# Built files carry a hash in their name, so they never change: keep them a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker: always checked for a newer one (app/offline/sw.ts).
/sw.js
  Cache-Control: no-cache

# The built files themselves are never pages to find.
/*
  X-Robots-Tag: noindex
