## Copy to keystore.properties (gitignored) for a local *release* build.
## Not needed for `npm run android` / debug builds - those always use debug.keystore.
## CI reads the equivalent ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD /
## ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD repository secrets instead - see
## .github/workflows/reader-android-release-apk.yml and apps/mobile/README.md.


storeFile=/absolute/path/to/sichos-kodesh-upload.keystore
storePassword=REPLACE_ME
keyAlias=sichos-kodesh-upload
keyPassword=REPLACE_ME
