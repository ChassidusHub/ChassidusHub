# /etc/sk-archive/restic.env - backups of raw/ (originals + index) to a bucket.
export RESTIC_REPOSITORY=s3:https://<account id>.r2.cloudflarestorage.com/sk-archive-backup
export RESTIC_PASSWORD=<long random passphrase, kept offline too>
export AWS_ACCESS_KEY_ID=<R2 access key>
export AWS_SECRET_ACCESS_KEY=<R2 secret>
