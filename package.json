{
  "name": "chassidushub",
  "private": true,
  "description": "ChassidusHub: the open, community-edited index of Chabad Torah and media.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChassidusHub/ChassidusHub.git"
  },
  "homepage": "https://chassidushub.org",
  "bugs": {
    "url": "https://github.com/ChassidusHub/ChassidusHub/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm run typecheck -w @chassidushub/web && npm run typecheck -w @chassidushub/www",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run build:web && npm run build:www && npm test && npm run catalog:check",
    "catalog:check": "tsx services/jobs/src/bin/chassidushub.ts schema-check",
    "db:migrate": "tsx services/jobs/src/bin/chassidushub.ts migrate",
    "dev:api": "tsx services/api/src/node.ts",
    "chassidushub": "tsx services/jobs/src/bin/chassidushub.ts",
    "sample": "tsx services/jobs/src/bin/chassidushub.ts sample",
    "dev:web": "npm run dev -w @chassidushub/web",
    "build:web": "npm run build -w @chassidushub/web",
    "dev:www": "npm run dev -w @chassidushub/www",
    "build:www": "npm run build -w @chassidushub/www",
    "cloudflare:setup": "scripts/cloudflare-setup.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
