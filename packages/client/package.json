{
  "name": "@chassidushub/client",
  "version": "1.0.0",
  "description": "A small typed TypeScript client for the ChassidusHub API, generated from its OpenAPI document: search, items, texts, suggestions, with API tokens and cursor paging.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://chassidushub.org/developers/client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChassidusHub/ChassidusHub.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/ChassidusHub/ChassidusHub/issues"
  },
  "keywords": [
    "chassidushub",
    "chabad",
    "torah",
    "api",
    "client",
    "openapi"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "generate": "tsx scripts/generate.ts"
  }
}
