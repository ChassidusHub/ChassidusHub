{
  "name": "@sichos-kodesh/mobile",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "preandroid": "npm run build -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core",
    "android": "react-native run-android",
    "preios": "npm run build -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "prestart": "npm run build -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core",
    "start": "react-native start",
    "pretest": "npm run build -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core",
    "test": "jest",
    "pretypecheck": "npm run build -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core",
    "typecheck": "tsc --noEmit",
    "android:assembleDebug": "npm run prebuild:check && cd android && ./gradlew assembleDebug --stacktrace",
    "android:smoke": "bash scripts/android-smoke-test.sh",
    "android:smoke:buildonly": "bash scripts/android-smoke-test.sh --build-only",
    "prebuild:check": "bash scripts/prebuild-check.sh",
    "android:release": "npm run prebuild:check && cd android && ./gradlew assembleRelease",
    "android:ui-walkthrough": "bash scripts/android-ui-walkthrough.sh",
    "release-notes": "tsx scripts/release-notes.ts"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sichos-kodesh/app-core": "^0.1.0",
    "@sichos-kodesh/catalog": "^0.1.0",
    "@sichos-kodesh/kvius-engine": "^0.1.0",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.24.11",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-track-player": "^4.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
