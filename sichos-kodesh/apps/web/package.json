{
  "name": "@sichos-kodesh/web",
  "private": true,
  "version": "1.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build -w @sichos-kodesh/design -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core -w @sichos-kodesh/sefaria-index",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run build -w @sichos-kodesh/design -w @sichos-kodesh/kvius-engine -w @sichos-kodesh/catalog -w @sichos-kodesh/app-core -w @sichos-kodesh/sefaria-index",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
    "@sichos-kodesh/catalog": "^0.1.0",
    "@sichos-kodesh/kvius-engine": "^0.1.0",
    "@vercel/analytics": "^2.0.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.45.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.3",
    "@sichos-kodesh/app-core": "^0.1.0",
    "@sichos-kodesh/design": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
