{
  "name": "@sichos-kodesh/mafteiach-index",
  "version": "0.1.0",
  "description": "Indexer for mafteiach.app: builds a local dataset of every recorded farbrengen/sicha occasion, with its mugah/bilti-mugah/hanacha, audio, video, English and maamorim breakdown.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "crawl": "tsx bin/crawl.ts"
  },
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
