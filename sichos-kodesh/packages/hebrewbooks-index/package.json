{
  "name": "@sichos-kodesh/hebrewbooks-index",
  "version": "0.1.0",
  "private": true,
  "description": "Reads Otzaria's public HebrewBooks catalog (otzar-HB_catalog), keeps the Chabad shelf, and groups it by author and series: bibliographic facts and links to hebrewbooks.org, never the scans (docs/chabad-library-plan.md, WP19).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./series": {
      "types": "./dist/series.d.ts",
      "default": "./dist/series.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "import-hebrewbooks": "tsx bin/import.ts"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
