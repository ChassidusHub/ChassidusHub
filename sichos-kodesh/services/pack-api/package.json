{
  "name": "@sichos-kodesh/pack-api",
  "version": "0.1.0",
  "private": true,
  "description": "The pack API (Cloudflare Worker over R2): serves the published archive's prebuilt packs and index.json, and streams a signed custom pack for any scope, profile and sections, built from the archive's objects in one pass.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build -w @sichos-kodesh/pack-format",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @sichos-kodesh/pack-format",
    "test": "vitest run",
    "pretypecheck": "npm run build -w @sichos-kodesh/pack-format",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "license": "ISC",
  "dependencies": {
    "@sichos-kodesh/app-core": "^0.1.0",
    "@sichos-kodesh/catalog": "^0.1.0",
    "@sichos-kodesh/pack-format": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.131.0"
  }
}
