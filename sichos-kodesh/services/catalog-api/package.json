{
  "name": "@sichos-kodesh/catalog-api",
  "version": "0.1.0",
  "private": true,
  "description": "api.sk.chassidushub.org - the catalog release the apps fetch (manifest + versioned catalog.json), as a Cloudflare Worker whose data is generated from this repository's own catalog at build time.",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @sichos-kodesh/catalog",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@sichos-kodesh/catalog": "^0.1.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.131.0"
  }
}
