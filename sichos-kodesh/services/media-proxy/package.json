{
  "name": "@sichos-kodesh/media-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Media proxy & kvius scheduling service: proxies Drive-hosted hanacha/maamar PDFs and JEM audio, and serves the Sichos Kodesh scheduling engine.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sichos-kodesh/kvius-engine": "*",
    "@hebcal/core": "^6.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
