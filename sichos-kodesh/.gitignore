node_modules/
dist/
*.log
.DS_Store
.wrangler/

# packages/mafteiach-index: raw HTTP response cache and the full generated
# dataset are deliberately not committed - see that package's README for why
# (resumable/reproducible from the crawler code instead of a data dump).
packages/mafteiach-index/.cache/
packages/mafteiach-index/data/
packages/mafteiach-index/*.db
packages/mafteiach-index/*.db-shm
packages/mafteiach-index/*.db-wal

# packages/jem-index: same reasoning - JEM's ccdb responses and the crawled
# catalog are a local build artifact, reproducible from the crawler code.
packages/jem-index/.cache/
packages/jem-index/data/
packages/jem-index/*.db
packages/jem-index/*.db-shm
packages/jem-index/*.db-wal
